# OpenAI is still used for embeddings (cheap, reliable).
OPENAI_API_KEY=sk-...

# freellmapi proxies multiple free LLM providers (Gemini, Groq, Cerebras,
# Mistral...). Used for chat completion. The base URL ends with /v1.
FREELLM_KEY=freellmapi-...
FREELLM_BASE_URL=https://freellmapi-production-bda8.up.railway.app/v1

# No longer required — chat.ts now routes through freellmapi.
