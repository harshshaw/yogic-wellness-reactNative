# Files / folders excluded from EAS uploads and fingerprinting.
#
# IMPORTANT: when this file exists, EAS uses it INSTEAD of .gitignore — not in
# addition to it. Anything you rely on .gitignore to exclude must be repeated
# here, or it gets uploaded on every build.

# The Expo app and the Vercel backend live in the same repo but are
# unrelated builds — EAS should never scan or ship the server folder.
server/
freellmapi/
docs/
*.md
.vercel/
.env
.env.*

# Build output. dist/ alone was ~430MB of stale web bundles going up on every
# build, because .gitignore stops applying once this file exists.
dist/
web-build/
.expo/
node_modules/

# Native project folders — regenerated by prebuild on EAS.
android/
ios/

# Local noise
.DS_Store
*.log
coverage/
.idea/
.vscode/
